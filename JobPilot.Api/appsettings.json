{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "OpenAI",
    "SemanticMatching": {
      "BatchSize": 6,
      "MaxRetryAttempts": 1
    },
    "OpenAI": {
      "Model": "gpt-6-luna",
      "MaxOutputTokens": 16384,
      "TokenLimits": {
        "Agent": 4096,
        "JobAnalysis": 8192,
        "SemanticMatching": 8192,
        "ResumeGeneration": 8192,
        "FinalResponse": 2048
      },
      "RequestTimeoutSeconds": 60
    },
    "Ollama": {
      "Model": "qwen2.5:3b",
      "BaseUrl": "http://localhost:11434/"
    },
    "Gemini": {
      "Model": "gemini-3.1-flash-lite"
    }
  }
}
