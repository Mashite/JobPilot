<div>
    <label class="form-label" for="@fieldId">@Label <span class="text-muted">(one per line)</span></label>
    <textarea id="@fieldId" class="form-control" rows="@Rows" @bind:get="text" @bind:set="UpdateAsync" @bind:event="oninput"></textarea>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public List<string> Values { get; set; } = [];
    [Parameter] public EventCallback<List<string>> ValuesChanged { get; set; }
    [Parameter] public int Rows { get; set; } = 3;

    private readonly string fieldId = $"profile-lines-{Guid.NewGuid():N}";
    private string text = "";

    protected override void OnInitialized() => text = string.Join('\n', Values);

    private Task UpdateAsync(string value)
    {
        text = value;
        return ValuesChanged.InvokeAsync(
            value.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList());
    }
}
