@page "/ai-assistant"
@rendermode InteractiveServer
@implements IDisposable

@using System.Text.Json
@using JobPilot.Web.Models
@using JobPilot.Web.Models.Agent
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject AgentResumeDraftState ResumeDraftState
@inject NavigationManager Navigation
@inject ResumeWorkflow ResumeWorkflow
@inject AgentConversationState Conversation

<PageTitle>JobPilot AI Assistant</PageTitle>

<div class="page-intro">
    <h2>JobPilot AI Assistant</h2>
    <p>Ask about a job, compare it with your profile, or draft a tailored resume.</p>
    @if (ResumeDraftState.Current is not null)
    {
        <a href="ai-assistant/resume">Return to resume draft</a>
    }
</div>

<section class="card chat-panel" aria-labelledby="chat-heading">
    <header class="chat-header">
        <div class="chat-heading">
            <h3 id="chat-heading">Conversation</h3>
            <span class="provider-label">Configured AI provider</span>
        </div>
        <button class="btn btn-outline-primary" type="button" @onclick="ClearChat"
                disabled="@(isSending || !HasChatState)">Clear Chat</button>
    </header>

    <div class="conversation" role="log" aria-label="Chat messages" tabindex="0" @ref="conversation">
        @if (messages.Count == 0)
        {
            <div class="chat-empty">
                <h4>Try an example prompt</h4>
                <p class="text-muted">Add a job description for a match analysis or resume draft.</p>
                <div class="actions example-prompts">
                    @foreach (var prompt in ExamplePrompts)
                    {
                        <button class="btn btn-outline-primary" type="button"
                                @onclick="() => SelectPromptAsync(prompt)">@prompt</button>
                    }
                </div>
            </div>
        }

        @foreach (var message in messages)
        {
            var isUser = message.Role == "user";
            <article @key="message" class="chat-message @(isUser ? "user-message" : "assistant-message")">
                <h4>@(isUser ? "You" : "Assistant")</h4>
                <p class="message-content">@message.Content</p>
                @if (message.Workflow is { } workflow)
                {
                    @if (workflow.Analysis is { } analysis)
                    {
                        <p><strong>@analysis.MatchScore% @(analysis.IsScoreProvisional ? "provisional match" : "match")</strong> · @analysis.Summary</p>
                        @if (analysis.StrongestAreas is { Count: > 0 })
                        {
                            <p><strong>Strongest areas</strong> · @string.Join(", ", analysis.StrongestAreas)</p>
                        }
                        @if (analysis.GapHighlights is { Count: > 0 })
                        {
                            <p class="text-muted"><strong>Gaps or items to review</strong> · @string.Join(", ", analysis.GapHighlights)</p>
                        }
                        @if (analysis.PendingRequirements > 0)
                        {
                            <p class="text-muted">@analysis.PendingRequirements requirements await semantic evaluation. Retry unfinished work to continue.</p>
                        }
                        else if (analysis.Status == "partial")
                        {
                            <p class="text-muted">Some semantic requirements still need review.</p>
                        }
                        <a class="btn btn-outline-primary" href="@($"ai-assistant/analysis/{analysis.AnalysisId:D}")">View Job Analysis</a>
                    }
                    @if (workflow.Resume is { } savedResume)
                    {
                        <div class="actions">
                            <button type="button" class="btn btn-primary" disabled="@(isSending || openingArtifact)"
                                    @onclick="() => OpenWorkflowResume(savedResume, download: false)">Edit Resume</button>
                            <button type="button" class="btn btn-outline-primary" disabled="@(isSending || openingArtifact)"
                                    @onclick="() => OpenWorkflowResume(savedResume, download: true)">Download DOCX</button>
                        </div>
                    }
                }

                @if (message.Tools.Count > 0)
                {
                    <div class="tool-results">
                        <p>Executed tools</p>
                        @foreach (var tool in message.Tools)
                        {
                            <details class="tool-result">
                                <summary><code>@tool.ToolName</code></summary>
                                <pre><code>@JsonSerializer.Serialize(tool.Result, IndentedJson)</code></pre>
                            </details>
                            @if (resumeResults.TryGetValue(tool, out var entry))
                            {
                                @if (entry.Result.Resume is { } resume)
                                {
                                    <div class="actions">
                                        <button type="button" class="btn btn-primary" disabled="@isSending"
                                                @onclick="() => OpenResume(resume, entry.JobDescription)">Edit Resume</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger" role="alert">@entry.Result.Error</div>
                                }
                            }
                        }
                    </div>
                }
            </article>
        }
    </div>

    <form class="chat-composer" @onsubmit="SendMessageAsync" @onsubmit:preventDefault>
        <div>
            <label class="form-label" for="assistant-job-description">
                Job Description <span class="text-muted">(optional)</span>
            </label>
            <textarea id="assistant-job-description" class="form-control" rows="3"
                      placeholder="Paste the job listing" @bind="jobDescription" @bind:event="oninput"
                      maxlength="80000" disabled="@isSending"></textarea>
        </div>
        <div>
            <label class="form-label" for="assistant-message">User Message</label>
            <textarea id="assistant-message" class="form-control" rows="2" @ref="messageInput"
                      placeholder="Ask the assistant a question" @bind="userMessage" @bind:event="oninput"
                      maxlength="8000" disabled="@isSending" required></textarea>
        </div>
        <div class="actions">
            <button class="btn btn-primary" type="submit" disabled="@isSending">Send Message</button>
            <span class="chat-status text-muted" role="status">
                @if (isSending)
                {
                    <span class="ui-spinner" aria-hidden="true"></span>
                    <span>@AgentWorkflowView.StageLabel(activeStage)…</span>
                }
            </span>
            @if (isSending)
            {
                <button class="btn btn-outline-primary" type="button" @onclick="CancelRun">Cancel</button>
            }
            else if (canRetry)
            {
                <button class="btn btn-outline-primary" type="button" @onclick="RetryWorkflow">Retry unfinished step</button>
            }
        </div>
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
    </form>
</section>

@code {
    private static readonly string[] ExamplePrompts =
    [
        "How well does my profile match this job?",
        "Draft a resume tailored to this job.",
        "How can I prepare for an interview?"
    ];

    private static readonly JsonSerializerOptions IndentedJson = new() { WriteIndented = true };
    private List<ChatMessage> messages => Conversation.Messages;
    private readonly Dictionary<AgentToolResult, (AgentResumeResult Result, string? JobDescription)> resumeResults =
        new(ReferenceEqualityComparer.Instance);
    private readonly CancellationTokenSource pageLifetime = new();
    private ElementReference conversation;
    private ElementReference messageInput;
    private string jobDescription = "";
    private string userMessage = "";
    private string? errorMessage
    {
        get => Conversation.Error;
        set => Conversation.Error = value;
    }
    private bool isSending;
    private bool scrollPending;
    private CancellationTokenSource? currentRun;
    private (Guid Id, AgentChatRequest Request)? lastWorkflow
    {
        get => Conversation.LastWorkflow;
        set => Conversation.LastWorkflow = value;
    }
    private string? activeStage;
    private bool canRetry
    {
        get => Conversation.CanRetry;
        set => Conversation.CanRetry = value;
    }
    private bool openingArtifact;

    private bool HasChatState => messages.Count > 0 || jobDescription.Length > 0 ||
        userMessage.Length > 0 || errorMessage is not null;

    private async Task SelectPromptAsync(string prompt)
    {
        userMessage = prompt;
        errorMessage = null;
        await messageInput.FocusAsync();
    }

    private async Task SendMessageAsync()
    {
        if (isSending)
            return;

        var message = userMessage.Trim();
        if (message.Length == 0)
        {
            errorMessage = "Enter a message to continue.";
            await messageInput.FocusAsync();
            return;
        }

        var description = string.IsNullOrWhiteSpace(jobDescription) ? null : jobDescription.Trim();
        var input = new AgentChatRequest(message, description);
        userMessage = "";
        messages.Add(new ChatMessage("user", message, []));
        scrollPending = true;
        if (description is not null)
        {
            lastWorkflow = (Guid.NewGuid(), input);
            await RunWorkflow(lastWorkflow.Value);
            return;
        }

        lastWorkflow = null;
        canRetry = false;
        activeStage = null;
        using var run = CancellationTokenSource.CreateLinkedTokenSource(pageLifetime.Token);
        currentRun = run;
        var cancellationToken = run.Token;
        isSending = true;
        errorMessage = null;

        try
        {
            using var client = HttpClientFactory.CreateClient("JobPilotApi");
            using var response = await client.PostAsJsonAsync(
                "api/agent/chat", input, cancellationToken);

            await response.EnsureJobPilotSuccessAsync(cancellationToken);

            var result = await response.Content.ReadFromJsonAsync<AgentChatResponse>(cancellationToken);
            if (result is null || string.IsNullOrWhiteSpace(result.Message) || result.ExecutedTools is null ||
                result.ExecutedTools.Any(tool => tool is null || string.IsNullOrWhiteSpace(tool.ToolName)))
            {
                throw new JsonException();
            }

            foreach (var tool in result.ExecutedTools.Where(tool => tool.ToolName == AgentResumeResult.ToolName))
                resumeResults.Add(tool, (AgentResumeResult.Parse(tool.Result), description));

            messages.Add(new ChatMessage("assistant", result.Message, result.ExecutedTools));
            scrollPending = true;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.StatusCode is null
                ? "Could not reach the JobPilot API. Check that it is running and try again."
                : ex.Message;
        }
        catch (JsonException)
        {
            errorMessage = "The JobPilot API returned an invalid chat response. Please try again.";
        }
        catch (OperationCanceledException)
        {
            if (!pageLifetime.IsCancellationRequested)
                errorMessage = run.IsCancellationRequested ? "Request canceled." : "The request timed out while waiting for the AI provider.";
        }
        finally
        {
            isSending = false;
            currentRun = null;
            if (errorMessage is not null)
                userMessage = message;
        }
    }

    private Task RetryWorkflow() => !isSending && lastWorkflow is { } workflow ? RunWorkflow(workflow) : Task.CompletedTask;

    private async Task RunWorkflow((Guid Id, AgentChatRequest Request) workflow)
    {
        using var run = CancellationTokenSource.CreateLinkedTokenSource(pageLifetime.Token);
        using var progress = CancellationTokenSource.CreateLinkedTokenSource(run.Token);
        currentRun = run;
        isSending = true;
        canRetry = false;
        errorMessage = null;
        activeStage = "intent";
        var polling = PollProgress(workflow.Id, progress.Token);
        try
        {
            using var client = HttpClientFactory.CreateClient("JobPilotApi");
            using var request = AgentWorkflowClient.Request(HttpMethod.Post, workflow.Id);
            request.Content = JsonContent.Create(workflow.Request);
            using var response = await client.SendAsync(request, run.Token);
            await response.EnsureJobPilotSuccessAsync(run.Token);
            var result = await response.Content.ReadFromJsonAsync<AgentWorkflowView>(run.Token) ?? throw new JsonException();
            activeStage = result.Stage;
            canRetry = result.CanRetry;
            if (result.Error is not null)
                errorMessage = $"{AgentWorkflowView.StageLabel(result.Stage)}: {result.Error}";
            if (result.Message is not null || result.Analysis is not null || result.Resume is not null)
            {
                var reply = new ChatMessage("assistant", result.Message ?? "Completed work is available below.", [], result);
                var existing = messages.FindIndex(item => item.Workflow?.Id == result.Id);
                if (existing < 0)
                    messages.Add(reply);
                else
                    messages[existing] = reply;
                scrollPending = true;
            }
        }
        catch (OperationCanceledException)
        {
            if (!pageLifetime.IsCancellationRequested)
            {
                canRetry = true;
                errorMessage = run.IsCancellationRequested ? "Request canceled. You can retry unfinished work."
                    : "The request timed out. You can retry unfinished work.";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            canRetry = true;
            errorMessage = ex switch
            {
                HttpRequestException { StatusCode: System.Net.HttpStatusCode.Conflict } => "This workflow is already running. Wait before retrying.",
                HttpRequestException { StatusCode: not null } => ex.Message,
                _ => "JobPilot could not read the workflow response."
            };
        }
        finally
        {
            await progress.CancelAsync();
            await polling;
            currentRun = null;
            isSending = false;
        }
    }

    private async Task PollProgress(Guid id, CancellationToken cancellationToken)
    {
        using var client = HttpClientFactory.CreateClient("JobPilotApi");
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(700));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                using var request = AgentWorkflowClient.Request(HttpMethod.Get, id);
                using var response = await client.SendAsync(request, cancellationToken);
                if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<AgentWorkflowView>(cancellationToken) is { } result &&
                    result.Stage != activeStage)
                {
                    activeStage = result.Stage;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or HttpRequestException or JsonException)
        {
            // The main response remains authoritative if the progress feed is interrupted.
        }
    }

    private void CancelRun() => currentRun?.Cancel();

    private async Task OpenWorkflowResume(AgentResumeSummary summary, bool download)
    {
        if (isSending || openingArtifact)
            return;
        openingArtifact = true;
        errorMessage = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("JobPilotApi");
            using var request = AgentWorkflowClient.Request(HttpMethod.Get, summary.ResumeId, "/resume");
            using var response = await client.SendAsync(request, pageLifetime.Token);
            await response.EnsureJobPilotSuccessAsync(pageLifetime.Token);
            var artifact = await response.Content.ReadFromJsonAsync<ResumeArtifact>(pageLifetime.Token) ?? throw new JsonException();
            if (download)
                await ResumeWorkflow.DownloadAsync(client, artifact.Resume, pageLifetime.Token);
            else
                OpenResume(artifact.Resume, artifact.JobDescription);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or OperationCanceledException or JSException)
        {
            if (!pageLifetime.IsCancellationRequested)
                errorMessage = "JobPilot could not open the saved resume draft.";
        }
        finally
        {
            openingArtifact = false;
        }
    }

    private sealed record ResumeArtifact(GeneratedResume Resume, string? JobDescription);

    private void ClearChat()
    {
        if (isSending)
            return;

        messages.Clear();
        resumeResults.Clear();
        lastWorkflow = null;
        canRetry = false;
        jobDescription = "";
        userMessage = "";
        errorMessage = null;
    }

    private void OpenResume(GeneratedResume resume, string? description)
    {
        if (isSending)
            return;

        ResumeDraftState.Open(resume, description);
        Navigation.NavigateTo("ai-assistant/resume");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollPending)
            return;

        scrollPending = false;
        try
        {
            await JS.InvokeVoidAsync("jobPilot.scrollToBottom", conversation);
        }
        catch (JSDisconnectedException)
        {
            // The chat is no longer connected to a browser.
        }
    }

    public void Dispose()
    {
        pageLifetime.Cancel();
        pageLifetime.Dispose();
    }
}
