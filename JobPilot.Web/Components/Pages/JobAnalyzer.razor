@page "/jobs"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Net
@using JobPilot.Web.Models
@using JobPilot.Web.Components.Resume
@using Microsoft.Extensions.Hosting
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject ResumeWorkflow ResumeWorkflow
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Job Analyzer - JobPilot</PageTitle>

<div class="page-intro">
    <h2>Analyze a job</h2>
    <p>Compare a job description with your profile, then draft a tailored resume and save the application.</p>
</div>

@if (HostEnvironment.IsDevelopment())
{
    <details class="card card-body actions-spaced">
        <summary>Development diagnostics</summary>
        <button type="button" class="btn btn-outline-primary" disabled="@loadingDiagnostics"
                @onclick="RefreshDiagnostics">Refresh diagnostics</button>
        @if (diagnosticError is not null)
        {
            <p role="alert">@diagnosticError</p>
        }
        @if (diagnostics is { } data)
        {
            <p>Master CV loaded @(data.MasterCvLoaded ? "Yes" : "No") · @data.EmploymentRecords employment records · @data.VerifiedSkills verified skills</p>
            <p>Provider @data.Provider · model @data.Model</p>
            <p>OpenAI requests @data.OpenAi.Requests · input tokens @data.OpenAi.InputTokens · output tokens @data.OpenAi.OutputTokens</p>
            @if (data.OpenAi.EstimatedUsd is { } estimate)
            {
                <p>Estimated cost @estimate.ToString("0.######") USD</p>
            }
        }
        @if ((reviewPreview ?? matchResult) is { } result)
        {
            <p>@result.Requirements.Count extracted requirements · score @result.MatchScore%</p>
            <ul>
                @foreach (var status in new[] { "exact", "equivalent", "semantic", "partial", "missing", "needs_verification", "pending_semantic" })
                {
                    <li>@JobMatchPresentation.Label(status) · @result.RequirementMatches.Count(item => JobMatchPresentation.Group(item.Status) == status)</li>
                }
            </ul>
        }
    </details>
}

<div class="analysis-workspace page-stack">
    @if (!resumeDraft.IsEditing)
    {
    <div class="analysis-grid">
        <section class="card analyzer-input" aria-labelledby="job-input-heading">
            <div class="card-body">
                <div class="section-heading">
                    <h3 id="job-input-heading">Job details</h3>
                    <p class="text-muted">Paste the full listing for a more useful skills comparison.</p>
                </div>

                <div class="job-fields">
                    <div>
                        <label for="company-name" class="form-label">Company Name</label>
                        <input id="company-name" class="form-control" maxlength="200"
                               placeholder="Enter the company name"
                               disabled="@(IsBusy || savedApplicationId.HasValue)"
                               @bind="companyName" @bind:event="oninput" />
                    </div>
                    <div>
                        <label for="job-title" class="form-label">Job Title <span class="field-note">(optional)</span></label>
                        <input id="job-title" class="form-control" maxlength="300"
                               placeholder="@JobTitlePlaceholder" aria-describedby="job-title-note"
                               aria-invalid="@(ApplicationTitle.Length > 300 ? "true" : null)"
                               disabled="@(IsBusy || savedApplicationId.HasValue)"
                               @bind="jobTitle" @bind:event="oninput" />
                        @if (ApplicationTitle.Length > 300)
                        {
                            <p id="job-title-note" class="validation-message">Enter a job title with 300 characters or fewer to save this job.</p>
                        }
                        else
                        {
                            <p id="job-title-note" class="field-note">Uses the title found in the listing if left blank.</p>
                        }
                    </div>
                </div>

                <div class="description-field">
                    <label for="job-description" class="form-label">Job Description</label>
                    <textarea id="job-description" class="form-control" rows="8" required @ref="descriptionInput"
                              aria-invalid="@(descriptionRequired ? "true" : null)"
                              aria-describedby="@(descriptionRequired ? "job-description-error" : null)"
                              placeholder="Paste the responsibilities and qualifications from the job listing..."
                              disabled="@IsBusy" @bind="jobDescription" @bind:after="ResetJobResults"></textarea>
                    @if (descriptionRequired)
                    {
                        <p id="job-description-error" class="validation-message" role="alert">Enter a job description to continue.</p>
                    }
                </div>

                <div class="actions actions-spaced">
                    <button type="button" class="btn btn-primary" disabled="@IsBusy" @onclick="AnalyzeJob">
                        @if (pendingOperation == Operation.Analyze)
                        {
                            <span class="ui-spinner" aria-hidden="true"></span>
                        }
                        @(pendingOperation == Operation.Analyze ? "Analyzing..." : "Analyze Job")
                    </button>
                </div>

                @if (errorOperation == Operation.Analyze)
                {
                    <div class="alert alert-danger actions-spaced" role="alert">@errorMessage</div>
                }
            </div>
        </section>

        <section class="card match-panel" aria-labelledby="match-heading">
            <div class="card-body">
                <h3 id="match-heading" tabindex="-1" @ref="matchHeading">Match analysis</h3>

                @if (pendingOperation == Operation.Analyze)
                {
                    <div class="match-empty" role="status">
                        <span class="match-empty-icon" aria-hidden="true"><span class="ui-spinner"></span></span>
                        <h4>Comparing your skills</h4>
                        <p class="text-muted">Checking the listing against the skills in your profile.</p>
                    </div>
                }
                else if (matchResult is not { } match)
                {
                    <div class="match-empty">
                        <span class="match-empty-icon" aria-hidden="true"><span class="app-icon icon-analyzer"></span></span>
                        <h4>No analysis yet</h4>
                        <p class="text-muted">Analyze a listing to see your match score, verified skills, and gaps.</p>
                    </div>
                }
                else
                {
                    var effectiveMatch = reviewPreview ?? match;
                    var score = Math.Clamp(effectiveMatch.MatchScore, 0, 100);
                    var stagedSkills = skillReview?.Staged.ToArray() ?? [];
                    var confirmedSkills = skillReview?.Confirmed.ToArray() ?? [];
                    var matchDetails = match.RequirementMatches.ToDictionary(item => item.Requirement.Skill, StringComparer.Ordinal);
                    var hasSavableSkills = confirmedSkills.Any(CanSaveProfileSkill);
                    var needsEvidence = stagedSkills.Any(skill => string.IsNullOrWhiteSpace(skillReview?.EvidenceFor(skill)));
                    var unmatchedSkills = effectiveMatch.MissingOrUnverifiedSkills
                        .Where(skill => !stagedSkills.Contains(skill) && !confirmedSkills.Contains(skill)).ToArray();

                    <div class="match-summary">
                        <div class="score-ring" style="@($"--match-score: {score}%")"
                             role="meter" aria-label="@(effectiveMatch.IsScoreProvisional ? "Provisional match score" :
                                  reviewPreview is null ? "Profile match score" : "Preview match score")"
                             aria-valuemin="0" aria-valuemax="100"
                             aria-valuenow="@score" aria-valuetext="@($"{score}%")">
                            <span aria-hidden="true">@score<span class="score-percent">%</span></span>
                        </div>
                        <div>
                            <p class="score-label">@(effectiveMatch.IsScoreProvisional ? "Provisional match score" :
                                reviewPreview is null ? "Profile match score" : "Preview match score")</p>
                            @if (!string.IsNullOrWhiteSpace(match.JobTitle))
                            {
                                <p class="match-title break-word">@match.JobTitle</p>
                            }
                            <p class="text-muted">@(reviewPreview is null
                                ? "Exact, equivalent, and supported semantic matches earn full credit. Partial matches earn half credit. Required items carry three times the weight of preferred items."
                                : $"With confirmed review skills. Master profile score: {match.MatchScore}%.")</p>
                        </div>
                    </div>
                    @foreach (var warning in match.Warnings)
                    {
                        <div class="alert alert-warning" role="status">@warning</div>
                    }
                    <JobSuitabilityPanel Assessment="effectiveMatch.Suitability" Provisional="effectiveMatch.IsScoreProvisional" />
                    @if (match.SemanticBatchFailures.Count > 1)
                    {
                        <ul class="text-muted">
                            @foreach (var batch in match.SemanticBatchFailures.GroupBy(failure => (failure.Batch, failure.Total)))
                            {
                                <li>Batch @batch.Key.Batch of @batch.Key.Total · @batch.Sum(failure => failure.PendingRequirements) pending</li>
                            }
                        </ul>
                    }
                    @if (match.IsScoreProvisional || match.SemanticStatus is "unavailable" or "incomplete")
                    {
                        <button type="button" class="btn btn-outline-primary" disabled="@IsBusy" @onclick="RetrySemantic">Retry pending semantic evaluation</button>
                    }

                    <div class="skill-groups">
                        <section class="skill-panel matched" aria-labelledby="matched-heading"
                                 @ondragover:preventDefault @ondrop:preventDefault @ondrop="DropInMatched">
                            <h4 id="matched-heading" tabindex="-1" @ref="matchedHeading">
                                Matched requirements <span class="skill-count">@((reviewPreview ?? match).MatchingSkills.Count)</span>
                            </h4>
                            @if (match.MatchingSkills.Count + stagedSkills.Length + confirmedSkills.Length == 0)
                            {
                                <p class="text-muted">No verified matches.</p>
                            }
                            else
                            {
                                @foreach (var status in new[] { "exact", "equivalent", "semantic" })
                                {
                                    var group = effectiveMatch.MatchingSkills.Where(skill =>
                                        !stagedSkills.Contains(skill) && !confirmedSkills.Contains(skill) &&
                                        (matchDetails.GetValueOrDefault(skill)?.Status ?? "exact") == status).ToArray();
                                    @if (group.Length > 0)
                                    {
                                        <h5 class="actions-spaced">@JobMatchPresentation.Label(status)</h5>
                                        <ul class="skill-list">
                                            @foreach (var skill in group)
                                            {
                                                <li>
                                                    @skill
                                                    @RenderRequirementEvidence(matchDetails.GetValueOrDefault(skill))
                                                    @if (status == "semantic")
                                                    {
                                                        <button type="button" class="btn btn-outline-primary skill-move" disabled="@IsBusy"
                                                                @onclick="() => StageSkill(skill, focusHeading: true)">Review AI match</button>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                }
                                <ul class="skill-list">
                                    @foreach (var skill in stagedSkills.Concat(confirmedSkills))
                                    {
                                        var isStaged = stagedSkills.Contains(skill);
                                        var detail = matchDetails.GetValueOrDefault(skill);
                                        <li @key="skill" draggable="@(!IsBusy ? "true" : "false")"
                                            @ondragstart="() => StartSkillDrag(skill, fromMatched: true)" @ondragend="ClearSkillDrag">
                                            @skill
                                            <small>@(isStaged ? "Needs confirmation" : CanSaveProfileSkill(skill)
                                                ? "Confirmed · skill not saved to Master CV" : "Confirmed · this job review only")</small>
                                            @if (isStaged)
                                            {
                                                @RenderRequirementEvidence(detail)
                                                <label>
                                                    <span>Supporting experience for @skill (required)</span>
                                                    <textarea class="form-control" rows="2" maxlength="1000" disabled="@IsBusy"
                                                              value="@skillReview?.EvidenceFor(skill)"
                                                              @oninput="args => skillReview?.SetEvidence(skill, args.Value?.ToString() ?? string.Empty)"></textarea>
                                                </label>
                                                <button type="button" class="btn btn-outline-primary skill-move"
                                                        disabled="@(IsBusy || string.IsNullOrWhiteSpace(skillReview?.EvidenceFor(skill)))"
                                                        @onclick="() => MarkRelated(skill)">Mark as Related</button>
                                                <button type="button" class="btn btn-outline-primary skill-move"
                                                        disabled="@IsBusy" @onclick="() => MarkMissing(skill)">Mark as Missing</button>
                                            }
                                            else if (skillReview?.EvidenceFor(skill) is { } note && !string.IsNullOrWhiteSpace(note))
                                            {
                                                <small>Review evidence: @note</small>
                                            }
                                            <button type="button" class="btn btn-outline-primary skill-move" disabled="@IsBusy"
                                                    aria-label="@($"Return {skill} to related and missing requirements")"
                                                    @onclick="() => ReturnSkill(skill, focusHeading: true)">Return</button>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>

                        <section class="skill-panel unverified" aria-labelledby="unverified-heading"
                                 @ondragover:preventDefault @ondrop:preventDefault @ondrop="DropInUnmatched">
                            <h4 id="unverified-heading" tabindex="-1" @ref="unmatchedHeading">
                                Related and missing requirements <span class="skill-count">@unmatchedSkills.Length</span>
                            </h4>
                            @if (unmatchedSkills.Length == 0)
                            {
                                <p class="text-muted">No gaps reported.</p>
                            }
                            else
                            {
                                @foreach (var status in new[] { "partial", "missing", "needs_verification", "pending_semantic" })
                                {
                                    var group = unmatchedSkills.Where(skill => JobMatchPresentation.Group(
                                        effectiveMatch.RequirementMatches.FirstOrDefault(item => item.Requirement.Skill == skill)?.Status) == status).ToArray();
                                    @if (group.Length > 0)
                                    {
                                        <h5 class="actions-spaced">@JobMatchPresentation.Label(status)</h5>
                                        <ul class="skill-list">
                                            @foreach (var skill in group)
                                            {
                                                var detail = matchDetails.GetValueOrDefault(skill);
                                                <li @key="skill" draggable="@(!IsBusy ? "true" : "false")"
                                                    @ondragstart="() => StartSkillDrag(skill, fromMatched: false)" @ondragend="ClearSkillDrag">
                                                    @skill
                                                    @RenderRequirementEvidence(reviewPreview?.RequirementMatches.FirstOrDefault(item => item.Requirement.Skill == skill) ?? detail)
                                                    @if (skillReview?.Related.Contains(skill) == true || skillReview?.Missing.Contains(skill) == true)
                                                    {
                                                        @if (skillReview.EvidenceFor(skill) is { } supportingNote)
                                                        {
                                                            <small>Review evidence: @supportingNote</small>
                                                        }
                                                        <button type="button" class="btn btn-outline-primary skill-move"
                                                                disabled="@IsBusy" @onclick="() => ReturnSkill(skill, focusHeading: true)">Keep previous classification</button>
                                                    }
                                                    @if (status is "partial" or "needs_verification")
                                                    {
                                                        <button type="button" class="btn btn-outline-primary skill-move"
                                                                disabled="@IsBusy" @onclick="() => MarkMissing(skill)">Keep as Missing</button>
                                                    }
                                                    <button type="button" class="btn btn-outline-primary skill-move" disabled="@IsBusy"
                                                            aria-label="@($"Move {skill} to Matched Skills for review")"
                                                            @onclick="() => StageSkill(skill, focusHeading: true)">Move to Matched</button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                }
                            }
                        </section>
                    </div>

                    @if (stagedSkills.Length + confirmedSkills.Length > 0)
                    {
                        <div class="skill-review-actions">
                            <p class="text-muted" role="status">@stagedSkills.Length awaiting confirmation · @confirmedSkills.Length manually confirmed</p>
                            @if (stagedSkills.Length > 0)
                            {
                                <p id="skill-confirmation-note">Confirm only requirements you genuinely meet. Cite supporting experience and include dates when minimum experience applies. To link a saved employer or project, enter its name or quote a saved responsibility or achievement.</p>
                            }
                            <div class="actions">
                                @if (stagedSkills.Length > 0)
                                {
                                    <button type="button" class="btn btn-outline-primary" disabled="@(IsBusy || needsEvidence)"
                                            aria-describedby="skill-confirmation-note" @onclick="ConfirmSkills">Confirm requirements</button>
                                }
                                @if (hasSavableSkills)
                                {
                                    <button type="button" class="btn btn-primary" disabled="@(IsBusy || stagedSkills.Length > 0)"
                                            @onclick="SaveProfileSkills">Save to Master Profile</button>
                                }
                            </div>
                        </div>
                    }
                    @if (hasSavedReview || skillReview?.HasOverrides == true)
                    {
                        <button type="button" class="btn btn-primary" disabled="@(IsBusy || stagedSkills.Length > 0)"
                                @onclick="SaveJobReview">Save job review</button>
                    }
                    @if (pendingOperation is Operation.PreviewSkills or Operation.SaveProfileSkills or Operation.SaveJobReview)
                    {
                        <p class="section-status" role="status">
                            <span class="ui-spinner" aria-hidden="true"></span>
                            @(pendingOperation == Operation.SaveProfileSkills ? "Saving verified skills…" :
                                pendingOperation == Operation.SaveJobReview ? "Saving job review…" : "Recalculating the score…")
                        </p>
                    }
                    @if (errorOperation is Operation.PreviewSkills or Operation.SaveProfileSkills or Operation.SaveJobReview)
                    {
                        <div class="alert alert-danger" role="alert">@errorMessage</div>
                        @if (errorOperation == Operation.PreviewSkills && confirmedSkills.Length > 0)
                        {
                            <div><button type="button" class="btn btn-outline-primary" disabled="@IsBusy"
                                         @onclick="RefreshSkillPreview">Retry score calculation</button></div>
                        }
                    }
                    @if (profileSaveMessage is not null)
                    {
                        <div class="alert alert-success" role="status">@profileSaveMessage</div>
                    }

                    @if (originalMatch is { } original)
                    {
                        var originalDetails = original.RequirementMatches.ToDictionary(item => item.Requirement.Skill, StringComparer.Ordinal);
                        <details class="match-evidence">
                            <summary>Original analysis (@original.MatchScore%)</summary>
                            <ul class="break-word">
                                @foreach (var requirement in original.Requirements)
                                {
                                    var status = originalDetails.GetValueOrDefault(requirement.Skill)?.Status;
                                    <li>@requirement.Skill (@requirement.Importance) · @JobMatchPresentation.Label(status)</li>
                                }
                            </ul>
                            @foreach (var (label, entries) in new[]
                            {
                                ("Experience requirements", original.ExperienceRequirements),
                                ("Technologies", original.Technologies),
                                ("Responsibilities", original.Responsibilities)
                            })
                            {
                                @if (entries.Count > 0)
                                {
                                    <h5 class="actions-spaced">@label</h5>
                                    <ul class="break-word">
                                        @foreach (var entry in entries)
                                        {
                                            <li>@entry</li>
                                        }
                                    </ul>
                                }
                            }
                        </details>
                    }

                }
            </div>
        </section>
    </div>

    <section class="card" aria-labelledby="resume-heading">
        <div class="card-body workflow-card">
            <div>
                <h3 id="resume-heading">Tailored resume</h3>
                <p class="text-muted">Generate a draft from your profile and the job description, then review and edit it.</p>
                <label><input type="checkbox" @bind="includeAllExperiences" disabled="@IsBusy" /> Include all Master CV positions</label>
            </div>
            <button type="button" class="btn btn-primary" disabled="@(IsBusy || string.IsNullOrWhiteSpace(jobDescription))" @onclick="OpenOrGenerateResume">
                @if (pendingOperation == Operation.GenerateResume)
                {
                    <span class="ui-spinner" aria-hidden="true"></span>
                }
                @(pendingOperation == Operation.GenerateResume ? "Generating..." :
                    resume is null ? "Generate Tailored Resume" : "Open Resume Editor")
            </button>
            @if (resume is not null)
            {
                <div class="workflow-feedback">
                    <button type="button" class="btn btn-outline-primary" disabled="@IsBusy" @onclick="RegenerateResume">
                        Regenerate draft
                    </button>
                </div>
            }
            @if (pendingOperation == Operation.GenerateResume)
            {
                <p class="section-status workflow-feedback" role="status">Preparing your resume draft...</p>
            }
            @if (errorOperation == Operation.GenerateResume)
            {
                <div class="alert alert-danger workflow-feedback" role="alert">@errorMessage</div>
            }
        </div>
    </section>
    }

    @if (resumeDraft.IsEditing && resume is not null)
    {
        <section class="resume-region" aria-label="Resume draft">
            <div class="actions">
                <button type="button" class="btn btn-outline-primary" disabled="@IsBusy" @onclick="BackToMatching">
                    Back to matching review
                </button>
                @if ((reviewPreview ?? matchResult) is { } review)
                {
                    <span class="text-muted">Reviewed match score @review.MatchScore%</span>
                }
            </div>
            <fieldset disabled="@IsBusy">
                <ResumeEditor Resume="resume" ResumeChanged="HandleResumeChanged" @ref="resumeEditor" />
            </fieldset>

            <div class="actions actions-spaced">
                <button type="button" class="btn btn-outline-primary" disabled="@IsBusy" @onclick="DownloadResume">
                    @if (pendingOperation == Operation.DownloadResume)
                    {
                        <span class="ui-spinner" aria-hidden="true"></span>
                    }
                    @(pendingOperation == Operation.DownloadResume ? "Preparing download..." : "Download Word Resume")
                </button>
            </div>
            @if (errorOperation == Operation.DownloadResume)
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }
        </section>
    }

    <section class="card" aria-labelledby="save-heading">
        <div class="card-body workflow-card">
            <div>
                <h3 id="save-heading">Save application</h3>
                @if (savedApplicationId.HasValue)
                {
                    <p class="text-muted">Open the saved application or save a new revision of the resume.</p>
                }
                else if (matchResult is null)
                {
                    <p class="text-muted">Analyze the job and enter a company name to save the application.</p>
                }
                else if (string.IsNullOrWhiteSpace(companyName) || string.IsNullOrWhiteSpace(ApplicationTitle))
                {
                    <p class="text-muted">Complete the company name and job title in Job details.</p>
                }
                else if (ApplicationTitle.Length > 300)
                {
                    <p class="text-muted">Shorten the job title in Job details before saving.</p>
                }
                else
                {
                    <p class="text-muted">Save this role, its match score, and any resume draft to Saved Jobs.</p>
                }
            </div>

            <div class="actions">
                @if (savedApplicationId is int applicationId)
                {
                    @if (resume is not null)
                    {
                        <button type="button" class="btn btn-primary" disabled="@IsBusy" @onclick="SaveResume">
                            @if (pendingOperation == Operation.SaveResume)
                            {
                                <span class="ui-spinner" aria-hidden="true"></span>
                            }
                            @(pendingOperation == Operation.SaveResume ? "Saving..." : "Save Resume")
                        </button>
                    }
                    <a class="btn btn-outline-primary" href="@($"/applications/{applicationId}?tab=resume")">Open Saved Application</a>
                }
                else
                {
                    <button type="button" class="btn btn-primary" disabled="@(!CanSaveJob)" @onclick="SaveJob">
                        @if (pendingOperation == Operation.SaveJob)
                        {
                            <span class="ui-spinner" aria-hidden="true"></span>
                        }
                        @(pendingOperation == Operation.SaveJob ? "Saving..." : resume is null ? "Save Job" : "Save Job and Resume")
                    </button>
                }
            </div>

            @if (pendingOperation is Operation.SaveJob or Operation.SaveResume)
            {
                <p class="section-status workflow-feedback" role="status">Saving to Saved Jobs...</p>
            }
            @if (errorOperation is Operation.SaveJob or Operation.SaveResume)
            {
                <div class="alert alert-danger workflow-feedback" role="alert">@errorMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(saveMessage))
            {
                <div class="alert alert-success workflow-feedback" role="status">@saveMessage</div>
            }
        </div>
    </section>
</div>

@code {
    private string jobDescription = "";
    private string companyName = "";
    private string jobTitle = "";
    private Operation? pendingOperation;
    private Operation? errorOperation;
    private string? errorMessage;
    private string? saveMessage;
    private int? savedApplicationId;
    private bool descriptionRequired;
    private ElementReference descriptionInput;
    private ElementReference matchHeading;
    private ResumeEditor? resumeEditor;
    private bool focusWorkflowPane;

    private JobMatchResult? matchResult;
    private JobMatchResult? originalMatch;
    private JobMatchResult? reviewPreview;
    private SkillReviewState? skillReview;
    private (string Skill, bool FromMatched)? draggedSkill;
    private ElementReference matchedHeading;
    private ElementReference unmatchedHeading;
    private string? profileSaveMessage;
    private bool hasSavedReview;
    private readonly JobResumeDraft resumeDraft = new();
    private GeneratedResume? resume => resumeDraft.Resume;

    private bool IsBusy => pendingOperation.HasValue;
    private string ApplicationTitle => string.IsNullOrWhiteSpace(jobTitle) ? matchResult?.JobTitle?.Trim() ?? "" : jobTitle.Trim();
    private string JobTitlePlaceholder => string.IsNullOrWhiteSpace(matchResult?.JobTitle)
        ? "Auto-detected from the listing"
        : matchResult.JobTitle;

    private bool CanSaveJob =>
        !IsBusy && !savedApplicationId.HasValue && matchResult is not null &&
        !string.IsNullOrWhiteSpace(companyName) && ApplicationTitle.Length is > 0 and <= 300;

    private enum Operation
    {
        Analyze,
        PreviewSkills,
        SaveProfileSkills,
        SaveJobReview,
        GenerateResume,
        DownloadResume,
        SaveJob,
        SaveResume
    }

    private void ResetJobResults()
    {
        if (savedApplicationId.HasValue)
        {
            companyName = "";
            jobTitle = "";
        }

        matchResult = null;
        originalMatch = null;
        reviewPreview = null;
        skillReview = null;
        draggedSkill = null;
        profileSaveMessage = null;
        hasSavedReview = false;
        resumeDraft.Reset();
        savedApplicationId = null;
        errorOperation = null;
        errorMessage = null;
        saveMessage = null;
        descriptionRequired = false;
    }

    private void HandleResumeChanged() => saveMessage = null;

    private Task AnalyzeJob() => LoadMatch(preserveReview: false);
    private async Task RetrySemantic()
    {
        await LoadMatch(preserveReview: true);
        if (errorOperation != Operation.Analyze && skillReview?.HasOverrides == true)
            await RefreshSkillPreview();
    }

    private Task LoadMatch(bool preserveReview) => ExecuteAsync(Operation.Analyze, async client =>
    {
        using var response = await client.PostAsJsonAsync("api/jobs/match", new { jobDescription });
        await response.EnsureJobPilotSuccessAsync();
        var received = await response.Content.ReadFromJsonAsync<JobMatchResult>()
            ?? throw new InvalidOperationException("The API did not return a match result.");
        matchResult = received.AutomaticResult ?? received;
        originalMatch = matchResult;
        if (preserveReview && skillReview is not null)
            skillReview.Include(ReviewableSkills(matchResult));
        else
        {
            skillReview = new SkillReviewState(ReviewableSkills(matchResult));
            if (received.SavedReview is { } review)
                skillReview.Restore(review.Confirmed, review.Related, review.Missing, review.Evidence);
        }
        reviewPreview = !preserveReview && received.AutomaticResult is not null ? received : null;
        hasSavedReview = received.SavedReview is not null || preserveReview && hasSavedReview;
        draggedSkill = null;
        profileSaveMessage = null;
    });

    private void StartSkillDrag(string skill, bool fromMatched)
    {
        if (!IsBusy)
            draggedSkill = (skill, fromMatched);
    }

    private void ClearSkillDrag() => draggedSkill = null;

    private async Task DropInMatched()
    {
        var drag = draggedSkill;
        ClearSkillDrag();
        if (drag is { FromMatched: false })
            await StageSkill(drag.Value.Skill, focusHeading: false);
    }

    private async Task DropInUnmatched()
    {
        var drag = draggedSkill;
        ClearSkillDrag();
        if (drag is { FromMatched: true })
            await ReturnSkill(drag.Value.Skill, focusHeading: false);
    }

    private async Task StageSkill(string skill, bool focusHeading)
    {
        if (IsBusy || skillReview?.Stage(skill) != true)
            return;

        profileSaveMessage = null;
        if (focusHeading)
            await matchedHeading.FocusAsync();
    }

    private async Task ReturnSkill(string skill, bool focusHeading)
    {
        if (IsBusy || skillReview is not { } review)
            return;

        var scoreChanged = review.Return(skill);
        if (scoreChanged)
            reviewPreview = null;
        if (focusHeading)
            await unmatchedHeading.FocusAsync();
        if (scoreChanged && review.HasOverrides)
            await RefreshSkillPreview();
        else if (scoreChanged && errorOperation == Operation.PreviewSkills)
            errorOperation = null;
    }

    private Task ConfirmSkills() => SubmitSkillReview(save: false, includeStaged: true);

    private Task RefreshSkillPreview() => SubmitSkillReview(save: false);
    private Task SaveProfileSkills() => SubmitSkillReview(save: true);
    private Task SaveJobReview() => SubmitSkillReview(save: false, persistReview: true);

    private async Task MarkRelated(string skill)
    {
        if (!IsBusy && skillReview?.MarkRelated(skill) == true)
            await RefreshSkillPreview();
    }

    private async Task MarkMissing(string skill)
    {
        if (!IsBusy && skillReview is { } review)
        {
            review.MarkMissing(skill);
            await RefreshSkillPreview();
        }
    }

    private async Task SubmitSkillReview(bool save, bool includeStaged = false, bool persistReview = false)
    {
        if (IsBusy || originalMatch is not { } original ||
            skillReview is not { } review || ((save || persistReview) && review.HasStaged))
        {
            return;
        }

        var confirmedSkills = (save ? review.Confirmed.Where(CanSaveProfileSkill)
            : includeStaged ? review.Confirmed.Concat(review.Staged) : review.Confirmed).ToArray();
        var relatedSkills = save ? [] : review.Related.Except(confirmedSkills, StringComparer.Ordinal).ToArray();
        var missingSkills = save ? [] : review.Missing.Except(confirmedSkills, StringComparer.Ordinal).ToArray();
        if (!persistReview && confirmedSkills.Length + relatedSkills.Length + missingSkills.Length == 0)
            return;
        var saved = false;
        await ExecuteAsync(save ? Operation.SaveProfileSkills : persistReview ? Operation.SaveJobReview : Operation.PreviewSkills, async client =>
        {
            using var request = new HttpRequestMessage(HttpMethod.Post,
                save ? "api/profile/skills" : persistReview ? "api/jobs/skill-review/save" : "api/jobs/skill-review/preview");
            if (save || persistReview)
                request.Headers.Add("X-JobPilot-Profile-Write", "1");

            request.Content = JsonContent.Create(new
            {
                analysis = new
                {
                    original.JobTitle, original.Requirements, original.ExperienceRequirements,
                    original.Technologies, original.Responsibilities
                },
                jobDescription,
                confirmedSkills,
                confirmedEvidence = review.EvidenceFor(confirmedSkills.Concat(relatedSkills)),
                relatedSkills,
                missingSkills,
                confirmCompetencies = save,
                confirmed = true
            });

            using var response = await client.SendAsync(request);
            if (!persistReview && response.StatusCode == HttpStatusCode.ServiceUnavailable)
                throw new InvalidOperationException(save
                    ? "Could not save the master profile. Check the database, or retry if another update is in progress."
                    : "Could not read the master profile to recalculate the score. Try again.");

            await response.EnsureJobPilotSuccessAsync();
            var updated = await response.Content.ReadFromJsonAsync<JobMatchResult>()
                ?? throw new InvalidOperationException("The API did not return a match result.");

            if (save)
            {
                matchResult = updated;
                review.AcceptSavedMatches(updated.RequirementMatches.Where(item => item.Status is "exact" or "equivalent")
                    .Select(item => item.Requirement.Skill));
                reviewPreview = null;
                saved = true;
                profileSaveMessage = "Verified skills were saved to Master CV.";
            }
            else
            {
                if (includeStaged)
                    review.Confirm();
                reviewPreview = updated;
                if (persistReview)
                {
                    hasSavedReview = review.HasOverrides;
                    profileSaveMessage = "Job review saved.";
                }
            }
        });

        if (saved && review.HasOverrides)
            await RefreshSkillPreview();
    }

    private Task OpenOrGenerateResume()
    {
        if (IsBusy || string.IsNullOrWhiteSpace(jobDescription))
            return Task.CompletedTask;
        if (resume is not { } current)
            return GenerateResume();
        resumeDraft.Open(current);
        focusWorkflowPane = true;
        return Task.CompletedTask;
    }

    private async Task RegenerateResume()
    {
        if (!IsBusy && await JS.InvokeAsync<bool>("confirm", "Replace the current draft? Previously saved versions will remain available."))
            await GenerateResume();
    }

    private void BackToMatching()
    {
        if (IsBusy)
            return;
        resumeDraft.Review();
        focusWorkflowPane = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusWorkflowPane)
            return;
        focusWorkflowPane = false;
        if (resumeDraft.IsEditing && resumeEditor is not null)
            await resumeEditor.FocusEditorAsync();
        else
            await matchHeading.FocusAsync();
    }

    private bool includeAllExperiences;
    private bool loadingDiagnostics;
    private Diagnostics? diagnostics;
    private string? diagnosticError;

    private async Task RefreshDiagnostics()
    {
        if (loadingDiagnostics)
            return;
        loadingDiagnostics = true;
        diagnosticError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("JobPilotApi");
            diagnostics = await client.GetFromJsonAsync<Diagnostics>("api/ai/diagnostics");
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            diagnosticError = "Development diagnostics are unavailable.";
        }
        finally
        {
            loadingDiagnostics = false;
        }
    }

    private sealed record Diagnostics(bool MasterCvLoaded, int EmploymentRecords, int VerifiedSkills,
        string Provider, string Model, Usage OpenAi);
    private sealed record Usage(long Requests, long InputTokens, long OutputTokens, decimal? EstimatedUsd);

    private Task GenerateResume() => ExecuteAsync(Operation.GenerateResume, async client =>
    {
        var hints = skillReview?.ResumeSkillHints.ToArray() ?? [];
        using var response = await client.PostAsJsonAsync("api/resumes/generate", new
        {
            jobDescription,
            confirmedSkills = hints,
            confirmedEvidence = skillReview?.EvidenceFor(hints).Values.ToArray(),
            includeAllExperiences
        });
        await response.EnsureJobPilotSuccessAsync();
        var draft = await response.Content.ReadFromJsonAsync<GeneratedResume>()
            ?? throw new InvalidOperationException("The API did not return a resume draft.");
        resumeDraft.Open(draft);
        focusWorkflowPane = true;
        saveMessage = null;
    });

    private async Task DownloadResume()
    {
        if (IsBusy || resume is not { } draft || !await ValidateResumeNameAsync())
            return;

        await ExecuteAsync(Operation.DownloadResume, client => ResumeWorkflow.DownloadAsync(client, draft, CancellationToken.None));
    }

    private async Task SaveJob()
    {
        if (!CanSaveJob || matchResult is not { } match || !await ValidateResumeNameAsync())
            return;

        await ExecuteAsync(Operation.SaveJob, async client =>
        {
            using var response = await client.PostAsJsonAsync(
                "api/applications",
                new
                {
                    jobTitle = ApplicationTitle,
                    companyName,
                    jobDescription,
                    matchScore = (reviewPreview ?? match).MatchScore,
                    reuseExisting = true,
                    resume
                });

            await response.EnsureJobPilotSuccessAsync();

            var saved = await response.Content.ReadFromJsonAsync<SavedApplicationResponse>();
            savedApplicationId = saved is { Id: > 0 }
                ? saved.Id
                : throw new InvalidOperationException("The API did not return the saved application ID.");

            saveMessage = resume is null ? "Job saved." : "Job and resume saved.";
        });
    }

    private async Task SaveResume()
    {
        if (IsBusy || savedApplicationId is not int applicationId || resume is not { } draft || !await ValidateResumeNameAsync())
            return;

        await ExecuteAsync(Operation.SaveResume, async client =>
        {
            saveMessage = null;
            var result = await ResumeWorkflow.SaveAsync(client, applicationId, draft, CancellationToken.None);
            saveMessage = result.Created ? "Resume version saved to this application." : "This resume version was already saved.";
        });
    }

    private class SavedApplicationResponse
    {
        public int Id { get; set; }
    }

    private async ValueTask<bool> ValidateResumeNameAsync()
    {
        if (resume is null || !string.IsNullOrWhiteSpace(resume.FullName))
            return true;

        if (resumeEditor is not null)
            await resumeEditor.FocusFullNameAsync();

        return false;
    }

    private async Task ExecuteAsync(Operation operation, Func<HttpClient, Task> request)
    {
        if (IsBusy)
            return;

        if (string.IsNullOrWhiteSpace(jobDescription))
        {
            descriptionRequired = true;
            errorOperation = null;
            errorMessage = null;
            await descriptionInput.FocusAsync();
            return;
        }

        pendingOperation = operation;
        errorOperation = null;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("JobPilotApi");
            await request(client);
        }
        catch (Exception ex)
        {
            ShowError(operation, ex.Message);
        }
        finally
        {
            pendingOperation = null;
        }
    }

    private void ShowError(Operation operation, string message)
    {
        errorOperation = operation;
        errorMessage = message;
    }

    public class JobMatchResult
    {
        public string JobTitle { get; set; } = "";
        public int MatchScore { get; set; }
        public List<string> MatchingSkills { get; set; } = [];
        public List<string> MissingOrUnverifiedSkills { get; set; } = [];
        public List<string> Evidence { get; set; } = [];
        public List<JobRequirement> Requirements { get; set; } = [];
        public List<string> ExperienceRequirements { get; set; } = [];
        public List<string> Technologies { get; set; } = [];
        public List<string> Responsibilities { get; set; } = [];
        public List<RequirementMatch> RequirementMatches { get; set; } = [];
        public List<string> Warnings { get; set; } = [];
        public string? SemanticStatus { get; set; }
        public bool IsScoreProvisional { get; set; }
        public JobSuitabilityView? Suitability { get; set; }
        public List<SemanticBatchFailure> SemanticBatchFailures { get; set; } = [];
        public SavedJobReview? SavedReview { get; set; }
        public JobMatchResult? AutomaticResult { get; set; }
    }

    public sealed record JobRequirement(
        string Skill, string Importance, string Category = "technology", int? MinimumExperienceMonths = null, string OriginalText = "",
        string? RequirementId = null, string? ParentGroup = null, string? ExpectedProficiency = null,
        string? AlternativeGroup = null, bool Critical = false);

    public sealed record RequirementMatch(
        JobRequirement Requirement, string Status, string? ProfileSkill, string Reason, bool CanConfirmSkill,
        bool CanSaveToMasterProfile = false, bool RequiresReviewEvidence = false,
        string? EvidenceExcerpt = null, string? EvidenceEmployer = null, string? EvidenceProject = null,
        IReadOnlyList<MatchCitation>? Citations = null);

    public sealed record MatchCitation(string Id, string Kind, string Excerpt, string? Employer, string? Project,
        string? Role, IReadOnlyList<string>? Technologies);
    public sealed record SavedJobReview(string[] Confirmed, string[] Related, string[] Missing, Dictionary<string, string> Evidence);
    public sealed record SemanticBatchFailure(int Batch, int Total, string Code, int PendingRequirements);

    private static IEnumerable<string> ReviewableSkills(JobMatchResult result) => result.RequirementMatches
        .Where(item => item.CanConfirmSkill).Select(item => item.Requirement.Skill).Concat(result.MissingOrUnverifiedSkills);

    private bool CanSaveProfileSkill(string skill) => matchResult?.RequirementMatches
        .Any(detail => detail.Requirement.Skill == skill && (detail.CanSaveToMasterProfile ||
             (detail.RequiresReviewEvidence && skill.Length <= 120 &&
              !string.IsNullOrWhiteSpace(skillReview?.EvidenceFor(skill))))) == true;

    private static RenderFragment RenderRequirementEvidence(RequirementMatch? detail) => @<text>
        @if (detail is not null)
        {
            <small>@(detail.Requirement.Importance == "required" ? "Required" : "Preferred") · @detail.Requirement.Category.Replace('_', ' ')</small>
            @if (detail.Requirement.Critical || detail.Requirement.AlternativeGroup is not null || detail.Requirement.ExpectedProficiency is not null)
            {
                <small>@(detail.Requirement.Critical ? "Critical · " : "")@(detail.Requirement.AlternativeGroup is not null ? "One of the listed alternatives · " : "")@detail.Requirement.ExpectedProficiency</small>
            }
            @if (detail.Requirement.MinimumExperienceMonths is > 0 and var months)
            {
                <small>Minimum experience: @months months</small>
            }
            @if (!string.IsNullOrWhiteSpace(detail.Requirement.OriginalText))
            {
                <small>Posting: @detail.Requirement.OriginalText</small>
            }
            @if (detail.ProfileSkill is { } skill)
            {
                <small>Master CV: @skill</small>
            }
            <small>@JobMatchPresentation.Label(detail.Status)</small>
            @if (!string.IsNullOrWhiteSpace(detail.EvidenceExcerpt))
            {
                <small>Evidence: @detail.EvidenceExcerpt</small>
                <small>@string.Join(" · ", new[] { detail.EvidenceEmployer, detail.EvidenceProject }.Where(value => !string.IsNullOrWhiteSpace(value)))</small>
            }
            <small>@detail.Reason</small>
            @if (detail.Citations is { Count: > 0 } citations)
            {
                <details>
                    <summary>Supporting Master CV evidence</summary>
                    @foreach (var citation in citations)
                    {
                        <p>
                            <strong>@string.Join(" · ", new[] { citation.Employer, citation.Role, citation.Project, citation.Kind }.Where(value => !string.IsNullOrWhiteSpace(value)))</strong>
                            <br />@citation.Excerpt
                            @if (citation.Technologies is { Count: > 0 } technologies)
                            {
                                <br /><small>@string.Join(", ", technologies)</small>
                            }
                        </p>
                    }
                </details>
            }
        }
    </text>;
}
