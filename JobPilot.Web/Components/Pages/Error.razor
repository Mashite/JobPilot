@page "/Error"
@using System.Diagnostics

<PageTitle>Error - JobPilot</PageTitle>

<section class="card message-card" aria-labelledby="error-heading">
    <div class="card-body">
        <h2 id="error-heading">An error occurred while processing your request</h2>

        @if (ShowRequestId)
        {
            <p class="break-word"><strong>Request ID:</strong> <code>@RequestId</code></p>
        }

        <h3>Development Mode</h3>
        <p>Switching to the <strong>Development</strong> environment displays more details about this error.</p>
        <p>
            For local debugging, set <code>ASPNETCORE_ENVIRONMENT</code> to <strong>Development</strong> and restart the app.
            Use this setting for local debugging because exception details may contain sensitive information.
        </p>
        <div class="actions"><a class="btn btn-outline-primary" href="">Back to Dashboard</a></div>
    </div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
